# ==========================================
# FactFinder Environment Configuration Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==========================================

# --- Live Web & Search Providers ---
# TinyFish: Mandatory for AzinHack evaluation ($13 free credits via hackathon link)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Tavily: Live web search & content extraction
TAVILY_API_KEY=your_tavily_api_key_here

# Exa: Web search & neural retrieval
EXA_API_KEY=your_exa_api_key_here

# --- LLM Providers ---
# OpenAI (gpt-4o-mini / gpt-4o)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Free tier: aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (Free tier fallback: console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Observability & Tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=FactFinder

# --- App & Cache Settings ---
DB_PATH=data/factfinder.db
CACHE_TTL_HOURS=24
FETCH_DAILY_LIMIT=900
RATE_LIMIT_CHECKS=6
RATE_LIMIT_WINDOW_SECONDS=600
